[Unit]
Description=HYDRA-UMC read-only node diagnostics agent
Documentation=https://github.com/JuanenRac/HYDRA-UMC-OS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-agent
Group=hydra-umc-agent
ExecStart=/usr/local/bin/hydra-umc-agent --config /etc/hydra-umc/config.json --report-on-change serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
CapabilityBoundingSet=
LockPersonality=true
PrivateTmp=true
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hydra-umc
UMask=0027
# The disk check measures the volume of the data folder, not the root (diagnostics.storage_path of the configuration can name another one).
WorkingDirectory=/var/lib/hydra-umc
# The agent only reads /sys and /proc and writes to the journal: it opens no network socket, needs no device, no clock change, no namespace and sees no other process.
# The network itself stays visible on purpose (it reports the interfaces), so PrivateNetwork is not set.
ProtectProc=invisible
PrivateDevices=true
ProtectClock=true
ProtectKernelLogs=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# A real, initial cgroup memory ceiling - conservative defaults, meant to be refined once real telemetry from this service running on the CM5 exists, never removed back to unlimited.
MemoryAccounting=yes
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
