# =============================================================================
# Runs provisioning/wifi_provision.py --apply once at boot, after
# NetworkManager itself is up. If the interface already has a real WiFi
# connection, the script exits almost immediately (ensure_hotspot_if_
# disconnected() is a real no-op in that case) - Type=oneshot with
# RemainAfterExit=no reflects that real "runs once per boot, then done"
# shape, not a long-lived daemon.
#
# Runs as root: real NetworkManager connection profile management
# (nmcli device wifi hotspot/connect, connection down/delete) needs it -
# unlike hydra-umc-agent.service's own deliberately read-only, unprivileged
# scope (see that unit's own header), this unit's whole job is a real,
# privileged network reconfiguration action.
# =============================================================================

[Unit]
Description=HYDRA-UMC first-contact WiFi provisioning (AP mode + client join)
Documentation=https://github.com/JuanenRac/HYDRA-UMC-OS
After=NetworkManager.service network-pre.target
Wants=NetworkManager.service
Before=network-online.target

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/bin/python3 /opt/hydra-umc/wifi-provision/wifi_provision.py --apply --ifname wlan0 --ap-ssid HYDRA-UMC-SETUP --state-dir /var/lib/hydra-umc/wifi-provision
# The AP password and the one-time setup code are generated per device on the first start
# and kept in /var/lib/hydra-umc/wifi-provision/credentials.json (0600); the service logs
# them once (journalctl -u hydra-umc-wifi-provision | grep WIFI_PROVISION=CREDENTIALS) so
# they can be written on the device label. No password is ever taken from the source code.
# Optional /etc/hydra-umc/wifi-provision.env may set HYDRA_UMC_AP_PASSWORD (12+ characters)
# or HYDRA_UMC_AP_WINDOW_S (seconds the setup network stays open, default 1800).
EnvironmentFile=-/etc/hydra-umc/wifi-provision.env
StateDirectory=hydra-umc/wifi-provision
StateDirectoryMode=0700
Restart=on-failure
RestartSec=15
TimeoutStartSec=0
NoNewPrivileges=false
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true

# A real, initial cgroup memory ceiling - conservative defaults, meant to be refined once real telemetry from this service running on the CM5 exists, never removed back to unlimited.
MemoryAccounting=yes
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
