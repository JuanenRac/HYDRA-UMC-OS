[Unit]
Description=HYDRA-UMC fleet update helper: a request of the server is waiting

[Path]
PathExists=/opt/hydra-umc/server/data/fleet-update/request.json
Unit=hydra-umc-fleet.service

[Install]
WantedBy=multi-user.target
