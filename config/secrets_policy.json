{
  "format": "hydra-secrets-policy/1",
  "directory": "/etc/hydra-umc",
  "patterns": ["*.env", "*.key", "*.pem", "*.token", "*.secret"],
  "expected_owner": "root",
  "group_prefix": "hydra-umc-",
  "max_mode": "640",
  "world_access_is_failure": true,
  "wrong_group_is_failure": false,
  "empty_file_is_warning": true
}
