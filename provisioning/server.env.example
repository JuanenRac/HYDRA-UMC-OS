NODE_ENV=production
PORT=3000
JWT_SECRET=SET_LOCALLY_TO_A_LONG_RANDOM_VALUE
HYDRA_UMC_BOOTSTRAP_ADMIN_USERNAME=hydra_umc
HYDRA_UMC_BOOTSTRAP_ADMIN_PASSWORD=SET_LOCALLY_AND_REMOVE_AFTER_FIRST_START

# Optional bounded Voice UI relay. Keep it on loopback and use the exact same
# secret as /etc/hydra-umc/voice-ui.env. Server owns this secret; watches and
# phones authenticate only to Server and never receive it.
HYDRA_UMC_VOICE_UI_URL=http://127.0.0.1:8091
HYDRA_UMC_VOICE_UI_TOKEN=SET_LOCALLY_TO_THE_SAME_LONG_RANDOM_VALUE
HYDRA_UMC_VOICE_UI_TIMEOUT_MS=4000

# Optional Datalake proxy for STUDIO's Ecosystem > Telemetry panel (GET
# /api/datalake/*). Leave commented out until HYDRA-UMC-DATALAKE is actually
# installed and running on this node - Server answers 503 "not configured"
# for the whole route family rather than guessing a process is there. See
# HYDRA-UMC-DATALAKE/src/hydra_umc_datalake/api.py for the real HTTP API this
# points at (no auth of its own today, same same-host-only assumption as
# every other real service probe in server.ts).
#HYDRA_UMC_DATALAKE_URL=http://127.0.0.1:8095
#HYDRA_UMC_DATALAKE_TIMEOUT_MS=4000

# Optional local spi_bridge proxy for STUDIO's Flasher/Tester (real CANOTA
# firmware flashing over the CM5's own SPI1 + HYDRA_DATA_READY GPIO line, see
# HYDRA-UMC/src/cm5_host/spi_bridge/). Leave commented out until spi_bridge
# is actually installed and running - every /api/hardware/canota/* route
# answers 503 rather than silently pretending hardware is connected.
#HYDRA_UMC_SPI_BRIDGE_URL=http://127.0.0.1:8765
#HYDRA_UMC_SPI_BRIDGE_TIMEOUT_MS=4000
